# Azure Blob Storage — connection string from plumonetuploads storage account
# Portal → plumonetuploads → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=plumonetuploads;AccountKey=<your-account-key>;EndpointSuffix=core.windows.net

# Modal Pattern-5 streaming inference endpoint (printed by `modal deploy modal_inference.py`)
MODAL_STREAM_ENDPOINT=https://<workspace>--plumonet-inference-web.modal.run

# Shared secret required by modal_inference.py's /stream route — must match the
# value stored in the Modal secret "plumonet-shared-secret"
# (modal secret create plumonet-shared-secret PLUMONET_SHARED_SECRET="...")
PLUMONET_SHARED_SECRET=<same-random-token-as-the-modal-secret>
